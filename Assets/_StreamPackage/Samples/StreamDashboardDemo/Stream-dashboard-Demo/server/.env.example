# Port the signaling server + REST API listen on.
# Point your Unity StreamConfig.serverUrl at ws://<this-machine's-ip>:<PORT>
PORT=3000

# Optional. If unset, the server still works — it just skips the
# connect/disconnect history log (the live dashboard doesn't need Mongo at all,
# it only tracks currently-connected players in memory).
MONGODB_URI=mongodb://localhost:27017/webrtc_dashboard
